{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zelph.org/schema/partial-query-manifest-v1.schema.json",
  "title": "Zelph partial-query manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "dataset", "partitioning", "representationLayers", "source", "sections", "shards", "routingIndexes", "fallback"],
  "properties": {
    "schemaVersion": { "const": "zelph-partial-query-manifest-v1" },
    "layout": { "const": "zelph-hf-layout/v3" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string" },
        "manifestHash": { "$ref": "#/$defs/digest" }
      }
    },
    "partitioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "disjoint", "overlapSemantics", "globalCoverage"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "disjoint": { "type": "boolean" },
        "overlapSemantics": { "enum": ["none", "duplicate-identical-triples", "declared-overlap"] },
        "globalCoverage": { "type": "boolean" }
      }
    },
    "representationLayers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directClaim", "statement", "mainSnak", "qualifier", "reference", "rank", "names"],
      "properties": {
        "directClaim": { "type": "boolean" },
        "statement": { "type": "boolean" },
        "mainSnak": { "type": "boolean" },
        "qualifier": { "type": "boolean" },
        "reference": { "type": "boolean" },
        "rank": { "type": "boolean" },
        "names": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["binPath", "headerLengthBytes"],
      "properties": {
        "binPath": { "type": "string", "minLength": 1 },
        "headerLengthBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "nameOfNode", "nodeOfName"],
      "properties": {
        "left": { "$ref": "#/$defs/legacySection" },
        "right": { "$ref": "#/$defs/legacySection" },
        "nameOfNode": { "$ref": "#/$defs/legacySection" },
        "nodeOfName": { "$ref": "#/$defs/legacySection" }
      }
    },
    "shards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shard" } },
    "routingIndexes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/routingIndex" } },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedForCompleteness", "mode"],
      "properties": {
        "allowedForCompleteness": { "const": false },
        "mode": { "const": "reject" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "revision": { "type": "string" },
        "etag": { "type": "string" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minimum", "maximum"],
      "properties": {
        "kind": { "enum": ["subject", "predicate", "object", "node", "name", "byte"] },
        "minimum": { "type": ["integer", "string"] },
        "maximum": { "type": ["integer", "string"] },
        "inclusiveMaximum": { "type": "boolean", "default": true }
      }
    },
    "legacyChunk": {
      "type": "object",
      "additionalProperties": true,
      "required": ["chunkIndex", "length", "objectPath"],
      "properties": {
        "chunkIndex": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1 },
        "objectPath": { "type": "string", "minLength": 1 },
        "which": { "type": "string" },
        "lang": { "type": "string" }
      }
    },
    "legacySection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["chunks"],
      "properties": {
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/legacyChunk" } }
      }
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "chunkIndex", "byteSize", "digest", "transports", "layers", "ranges"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "section": { "enum": ["left", "right", "nameOfNode", "nodeOfName"] },
        "chunkIndex": { "type": "integer", "minimum": 0 },
        "byteSize": { "type": "integer", "minimum": 1 },
        "formatVersion": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "transports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transport" } },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["directClaim", "statement", "mainSnak", "qualifier", "reference", "rank", "names"] }
        },
        "ranges": { "type": "array", "items": { "$ref": "#/$defs/range" } },
        "overlaps": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "routingIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "exhaustive", "digest", "transports", "formatVersion", "layers"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "key": { "enum": ["node", "subject", "subjectPredicate", "predicate", "objectPredicate", "name", "global"] },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["directClaim", "statement", "mainSnak", "qualifier", "reference", "rank", "names"] }
        },
        "exhaustive": { "const": true },
        "formatVersion": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "transports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/transport" } }
      }
    }
  }
}
